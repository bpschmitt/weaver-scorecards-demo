# Copy to .env and fill in. docker compose reads .env automatically.

# --- Telemetry export (collector -> New Relic) ---

# New Relic ingest license key (required).
# https://one.newrelic.com/launcher/api-keys-ui.api-keys-launcher
NEW_RELIC_LICENSE_KEY=

# OTLP endpoint. Pick by account region:
#   US: https://otlp.nr-data.net
#   EU: https://otlp.eu01.nr-data.net
NEW_RELIC_OTLP_ENDPOINT=https://otlp.nr-data.net

# --- Scorecard (make scorecard-apply only; not needed for telemetry) ---

# User API key (NRAK-...) and account ID.
#NEW_RELIC_USER_API_KEY=
#NEW_RELIC_ACCOUNT_ID=
# us or eu
#NEW_RELIC_REGION=us

# Host port for the checkout service (container port stays 8080).
CHECKOUT_PORT=8080